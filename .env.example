# ---------------------------------------------------------------------------
# 4Geeks AC Dashboard — variables de entorno
# Copia este fichero a .env  (NUNCA lo subas a git; .env está en .gitignore)
# ---------------------------------------------------------------------------

# --- ActiveCampaign (alimenta Overview, Regions, Individual Leads, etc.) ---
AC_API_URL=https://TUCUENTA.api-us1.com
AC_API_KEY=

# --- Login del dashboard ---
DASHBOARD_USER=admin
DASHBOARD_PASS=cambia-esto

# --- Ads Performance en vivo desde 4Geeks Center ---
# La clave la genera Center en su servidor (setting cifrado `ads_api_key`).
# NO la pongas aquí en texto si vas a compartir el fichero: en producción va
# como variable de entorno en Railway.
CENTER_ADS_API_KEY=
# (opcionales — ya tienen buen valor por defecto)
# CENTER_ADS_URL=https://4geekscenter.duckdns.org/api/public/ads-performance
# CENTER_ADS_TTL_SECONDS=600

# Solo para PREVIEW LOCAL: pinta el tab de Ads con datos de EJEMPLO cuando no
# hay CENTER_ADS_API_KEY. Déjalo SIN poner (o =0) en Railway/producción.
# ADS_DEMO=1

# --- IA (opcional: tabs AI Insights / Lead Coach / Recommendations) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# --- Ajustes opcionales del pull de AC ---
# CACHE_TTL_SECONDS=1800
# DATA_WINDOW_MONTHS=6
# AC_DISABLE_ENRICHMENT=false
